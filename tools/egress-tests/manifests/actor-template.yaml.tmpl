# ActorTemplate (protojson-shaped ateapipb.ActorTemplate, not a CRD) for the
# egress scale test, created through the ate API by deploy.sh after
# `ko resolve` replaces the ko:// image reference.
#
# The actor's loop starts on POST /start rather than at boot, so the golden
# snapshot holds an idle actor. It sets no OTLP endpoint on purpose: telemetry
# export would be egress too, through the gateway this test measures.
metadata:
  atespace: egress-tests
  name: egress-tests-actor
workerSelector:
  matchLabels:
    workload: egress-tests
containers:
- name: actor
  image: ko://github.com/agent-substrate/substrate/tools/egress-tests/actor
  # Port 80 is the only inbound port forwarded into the actor sandbox.
  command: ["/ko-app/actor", "--listen=:80"]
  # Hold ResumeActor open until port 80 answers.
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: memory
    quantity: ${ACTOR_MEMORY}
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/egress-tests/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
