# What the in-cluster campaign runs as: ServiceAccount egress-campaign, with
# read-only access to exactly what the driver and campaign.py read.
# deploy.sh --campaign applies it with campaign-pvc.yaml.tmpl; the Pod is in
# campaign-pod.yaml.tmpl. The grants are checked against the driver's
# Kubernetes calls by TestCampaignRBACCoversTheDriver.

apiVersion: v1
kind: ServiceAccount
metadata:
  name: egress-campaign
  namespace: egress-tests
  labels:
    app.kubernetes.io/part-of: egress-tests
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: egress-campaign
  labels:
    app.kubernetes.io/part-of: egress-tests
rules:
# cAdvisor, read through the API server's node proxy.
- apiGroups: [""]
  resources: ["nodes/proxy"]
  verbs: ["get"]
# The roots of ateapi's serving certificate, v1 or v1beta1.
- apiGroups: ["certificates.k8s.io"]
  resources: ["clustertrustbundles"]
  verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: egress-campaign
  labels:
    app.kubernetes.io/part-of: egress-tests
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: egress-campaign
subjects:
- kind: ServiceAccount
  name: egress-campaign
  namespace: egress-tests
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: egress-campaign
  namespace: ate-system
  labels:
    app.kubernetes.io/part-of: egress-tests
rules:
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["get", "list"]
# The live :9090 counters and the gateway Envoy's admin :15000.
- apiGroups: [""]
  resources: ["pods/proxy"]
  verbs: ["get"]
- apiGroups: ["metrics.k8s.io"]
  resources: ["pods"]
  verbs: ["list"]
# The HTTPS preflight.
- apiGroups: [""]
  resources: ["configmaps"]
  resourceNames: ["egress-tests-target-ca"]
  verbs: ["get"]
- apiGroups: ["apps"]
  resources: ["deployments"]
  resourceNames: ["atenet-egress"]
  verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: egress-campaign
  namespace: egress-tests
  labels:
    app.kubernetes.io/part-of: egress-tests
rules:
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["get", "list"]
# The cgroup readers.
- apiGroups: [""]
  resources: ["pods/proxy"]
  verbs: ["get"]
- apiGroups: ["metrics.k8s.io"]
  resources: ["pods"]
  verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: egress-campaign
  namespace: egress-tests-targets
  labels:
    app.kubernetes.io/part-of: egress-tests
rules:
- apiGroups: [""]
  resources: ["services", "pods"]
  verbs: ["list"]
- apiGroups: ["metrics.k8s.io"]
  resources: ["pods"]
  verbs: ["list"]
# The HTTPS preflight.
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["egress-target-tls"]
  verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: egress-campaign
  namespace: kube-system
  labels:
    app.kubernetes.io/part-of: egress-tests
rules:
# The DNS pods, a cAdvisor target.
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["list"]
- apiGroups: ["metrics.k8s.io"]
  resources: ["pods"]
  verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: egress-campaign
  namespace: ate-system
  labels:
    app.kubernetes.io/part-of: egress-tests
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: egress-campaign
subjects:
- kind: ServiceAccount
  name: egress-campaign
  namespace: egress-tests
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: egress-campaign
  namespace: egress-tests
  labels:
    app.kubernetes.io/part-of: egress-tests
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: egress-campaign
subjects:
- kind: ServiceAccount
  name: egress-campaign
  namespace: egress-tests
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: egress-campaign
  namespace: egress-tests-targets
  labels:
    app.kubernetes.io/part-of: egress-tests
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: egress-campaign
subjects:
- kind: ServiceAccount
  name: egress-campaign
  namespace: egress-tests
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: egress-campaign
  namespace: kube-system
  labels:
    app.kubernetes.io/part-of: egress-tests
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: egress-campaign
subjects:
- kind: ServiceAccount
  name: egress-campaign
  namespace: egress-tests
