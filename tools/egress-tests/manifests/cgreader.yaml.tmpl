# The cgroup reader of the egress scale test: one pod per node reads the
# cgroup v2 CPU and memory files of the cgroups the driver names, every
# second, and serves the rows on :8080. The driver reaches it through the
# API server's pod proxy (pods/proxy get in egress-tests). It reads the
# host's cgroup tree read-only and needs no Kubernetes API access.

apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: egress-tests-cgreader
  namespace: egress-tests
  labels:
    app.kubernetes.io/part-of: egress-tests
spec:
  selector:
    matchLabels:
      app: egress-tests-cgreader
  template:
    metadata:
      labels:
        app: egress-tests-cgreader
    spec:
      automountServiceAccountToken: false
      # Run beside every workload, tainted nodes included.
      tolerations:
      - operator: Exists
      containers:
      - name: cgreader
        image: ko://github.com/agent-substrate/substrate/tools/egress-tests/cgreader
        args: ["--cgroup-root=/host-cgroup", "--interval=1s"]
        ports:
        - name: http
          containerPort: 8080
        readinessProbe:
          httpGet:
            path: /healthz
            port: http
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            cpu: 100m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65532
          runAsGroup: 65532
          capabilities:
            drop: ["ALL"]
        volumeMounts:
        - name: cgroup
          mountPath: /host-cgroup
          readOnly: true
      volumes:
      - name: cgroup
        hostPath:
          path: /sys/fs/cgroup
          type: Directory
