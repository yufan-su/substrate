# The campaign's output volume, mounted at /out. deploy.sh --campaign applies
# it; --delete-campaign keeps it unless --purge.

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: egress-campaign-out
  namespace: egress-tests
  labels:
    app.kubernetes.io/part-of: egress-tests
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: standard-rwo
  resources:
    requests:
      storage: 10Gi
