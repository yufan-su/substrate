# The server behind every endpoint of the egress scale test. deploy.sh renders
# target-service.yaml.tmpl once per endpoint, and all of those Services select
# this pod. One replica is enough: it answers far more requests than one
# egress gateway replica can send.

apiVersion: v1
kind: Namespace
metadata:
  name: egress-tests-targets

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: egress-target
  namespace: egress-tests-targets
spec:
  replicas: 1
  selector:
    matchLabels:
      app: egress-target
  template:
    metadata:
      labels:
        app: egress-target
    spec:
      containers:
      - name: target
        image: ko://github.com/agent-substrate/substrate/tools/egress-tests/target
        args: ["--listen=:8080"]
        ports:
        - name: http
          containerPort: 8080
        readinessProbe:
          httpGet:
            path: /healthz
            port: http
          periodSeconds: 2
        resources:
          requests:
            cpu: 500m
            memory: 64Mi
        # runAsUser must be spelled out: ko's distroless static base declares
        # no USER, so runAsNonRoot alone makes kubelet refuse to start it.
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65532
          runAsGroup: 65532
          capabilities:
            drop: ["ALL"]
