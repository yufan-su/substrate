# Worker pool for the egress scale test. The ActorTemplate is not a CRD: it
# lives in actor-template.yaml.tmpl and deploy.sh creates it through the ate
# API with `kubectl ate create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: egress-tests

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: egress-tests
  namespace: egress-tests
  labels:
    workload: egress-tests
spec:
  replicas: ${WORKER_COUNT}
  sandboxClass: gvisor
  workerImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
  ${WORKER_TEMPLATE}
